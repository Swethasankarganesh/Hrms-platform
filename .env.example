NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Database ──────────────────────────────────────────────────
# Local dev: a libSQL/SQLite file (created by `pnpm prisma db push`).
DATABASE_URL=file:./prisma/dev.db

# Production (Turso): set these in Vercel instead of DATABASE_URL.
# Get them from: turso db show <name> --url   and   turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── NextAuth ──────────────────────────────────────────────────
# Generate: openssl rand -base64 32  (a built-in fallback exists for demos)
AUTH_SECRET=

# ── AI assistant (Google Gemini, free tier) ───────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
