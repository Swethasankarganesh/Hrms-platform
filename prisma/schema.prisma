// PeopleFlow HRMS — PostgreSQL schema
// Run `pnpm prisma generate` after editing, and `pnpm prisma db push` to sync the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("hr") // admin | hr | employee
  createdAt DateTime @default(now())
}

model Employee {
  id         Int      @id // business id, e.g. 1001 (assigned in app code)
  name       String
  role       String
  department String
  email      String   @unique
  status     String   @default("Active") // Active | On leave
  location   String
  joined     String
  salary     Int
  score      Int      @default(75)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  status     String // Present | Remote | Late | Absent | Leave
  clockIn    String   @default("-")
  clockOut   String   @default("-")
  hours      String   @default("-")
  date       String // YYYY-MM-DD
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
}

model Leave {
  id         Int      @id // business id (assigned in app code)
  employeeId Int
  type       String
  from       String
  to         String
  days       Int
  reason     String   @default("")
  status     String   @default("Pending") // Pending | Approved | Declined
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payroll {
  id        Int      @id @default(autoincrement())
  month     String   @unique // e.g. "2026-06"
  status    String   @default("Draft") // Draft | Processed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
